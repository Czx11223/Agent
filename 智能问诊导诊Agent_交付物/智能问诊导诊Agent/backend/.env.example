# 后端环境变量样例 —— 复制为 .env 后填写
# [TLS] 生产环境禁止将真实密钥写入前端；本文件不入版本库/不暴露。

# JWT 密钥（生成：python -c "import secrets;print(secrets.token_urlsafe(48))"）
JWT_SECRET=please-change-me-to-a-long-random-secret
JWT_EXPIRE_HOURS=24

# LLM（OpenAI 兼容接口）
# 国内若需可直连端点请替换为对应合规服务。
LLM_API_KEY=sk-xxxxxx
LLM_BASE_URL=https://your-llm-endpoint/v1
LLM_MODEL=your-model-name

# 数据库（sqlite3，相对 backend 目录）
DB_PATH=./app.db

# 允许的前端来源（CORS，逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173